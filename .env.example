# ==========================================
# AR Furniture - Environment Variables
# ==========================================

# ------------------------------------------
# General Server & Frontend Settings
# ------------------------------------------
# The port the backend server runs on (default: 4000)
PORT=4000
# The base URL for the frontend to call the API. 
# Local dev: http://localhost:4000
# Production (Vercel): Leave empty so it uses relative paths
VITE_AUTH_API_BASE=http://localhost:4000

# ------------------------------------------
# AI Integration
# ------------------------------------------
# Google Gemini API key for product descriptions and assistant
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# Database (MongoDB)
# ------------------------------------------
# Your primary MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=arecommerce

# ------------------------------------------
# Storage Configuration
# ------------------------------------------
# Which storage provider to use: 'supabase' or 'storj' (default: storj)
STORAGE_PROVIDER=storj
# Default bucket name across providers
STORAGE_BUCKET=arfurniture

# ------------------------------------------
# Supabase Credentials (DB & Storage)
# ------------------------------------------
# Used for Supabase Storage (if enabled) and Postgres data storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Direct Postgres connection string (required for bootstrapping schema)
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
SUPABASE_DB_TABLE=app_documents
SUPABASE_STORAGE_BUCKET=arfurniture

# ------------------------------------------
# Storj Credentials (S3 Compatible Storage)
# ------------------------------------------
# Used if STORAGE_PROVIDER=storj
STORJ_ENDPOINT=https://gateway.storjshare.io
STORJ_ACCESS_KEY_ID=your_storj_access_key
STORJ_SECRET_ACCESS_KEY=your_storj_secret_key
STORJ_REGION=global
STORJ_BUCKET=arfurniture
# Optional: Base URL for serving public assets if different from endpoint
# STORJ_PUBLIC_BASE_URL=https://link.storjshare.io/s/...

# ==========================================
# Migration Scripts Settings
# ==========================================
# These variables are only needed when running the migration scripts 
# (node scripts/migrate-all.mjs) to switch accounts or environments.

# 1. MongoDB to Supabase Migration
# If migrating from another teammate's DB or old environment:
# SOURCE_MONGODB_URI=mongodb+srv://old-db...
# SOURCE_MONGODB_DB=arecommerce

# 2. Supabase to Storj Asset Migration
# If moving assets from an old Supabase account to a new Storj account:
# SOURCE_SUPABASE_URL=https://old-project.supabase.co
# SOURCE_SUPABASE_SERVICE_ROLE_KEY=old_service_key
# SOURCE_SUPABASE_BUCKET=arfurniture

# 3. Migration Flags
# Set to 'true' to force recreating the Supabase table even if it exists
FORCE_BOOTSTRAP=false
# Set to 'true' to upload files from public/products/ to your cloud storage
UPLOAD_LOCAL_ASSETS=false
# Set to 'true' to force cloud-to-cloud asset migration even if provider isn't storj
RUN_ASSET_MIGRATION=false

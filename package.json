{
  "name": "arfurniture",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "auth-server": "node server/index.mjs",
    "auth-server:watch": "node --watch server/index.mjs",
    "seed-superadmin": "node scripts/seed-superadmin.mjs",
    "start": "concurrently \"npm run dev\" \"npm run auth-server\" --names \"CLIENT,SERVER\" --prefix-colors \"cyan,magenta\"",
